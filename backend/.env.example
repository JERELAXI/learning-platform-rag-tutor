# ─── Postgres (docker-compose reads these to init the db container) ─────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=learning_platform

# ─── Backend (read by pydantic Settings in core/config.py) ──────────────────

# Async SQLAlchemy URL. Host = "db" is the docker-compose service name.
# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/learning_platform

# HMAC secret for signing JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-hex-string

# JWT tuning (optional, sensible defaults in core/config.py):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI API key — required for embeddings, chat and quiz generation.
OPENAI_API_KEY=sk-your-openai-key-here

# LLM / embedding tuning (optional, defaults match text-embedding-3-small):
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536              # must match the pgvector column dim in migration
# CHAT_MODEL=gpt-4o-mini

# RAG cosine-distance cutoff. Chunks with distance > threshold are treated as
# off-topic; the tutor refuses to answer instead of hallucinating.
# Calibrate by watching "RAG search ... distances=[...]" in web logs.
# RAG_DISTANCE_THRESHOLD=0.55

# Celery broker + result backend. Host = "redis" is the docker-compose service.
# REDIS_URL=redis://redis:6379/0

# Local directory (relative to backend/) where uploaded files are stored.
# UPLOADS_DIR=uploads
